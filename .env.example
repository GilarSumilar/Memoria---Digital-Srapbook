# Konfigurasi Supabase untuk Client Frontend
# Dapatkan Project URL dan anon public key dari Dashboard Supabase -> Project Settings -> API
# PENTING: Jangan pernah commit .env ke repository!
# Untuk production (Vercel, Netlify, etc), set variables ini di platform dashboard

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-anon-public-key-here

# Editor Configuration (opsional)
LAUNCH_EDITOR=code
